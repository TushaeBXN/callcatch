# ------------------------------------------------------------
# .env.example — a TEMPLATE for your local settings.
#
# How to use:
#   1. Copy this file:   cp .env.example .env
#   2. Put real values in .env (never in this file).
#   3. .env is gitignored, so git will never upload it.
#
# Every value below is FAKE. None of them will work.
# ------------------------------------------------------------

# --- LLM (the language model that writes the assistant's replies) ---
# Which adapter to use: "stub" (fake replies, no network, free) or "anthropic" (live, paid).
# The live adapter needs: pip install anthropic
LLM_PROVIDER=stub
LLM_API_KEY=fake-llm-key-000000000000
# TODO(me): Set the model name. You chose a fast, low-cost tier, since voice needs quick replies.
# For Anthropic, a small, fast model like "claude-haiku-4-5" is one option.
# VERIFY: check docs.anthropic.com for current model names and prices. They change.
LLM_MODEL=replace-with-current-model-name

# --- Voice / telephony (Twilio) ---
LLM_PROVIDER=stub
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=fake-auth-token-000000000000000000
# Set TWILIO_SKIP_VALIDATION=1 to skip signature checks during local development.
TWILIO_SKIP_VALIDATION=1
# TTS voice — any Twilio <Say> voice name. Polly voices sound best.
TWILIO_TTS_VOICE=Polly.Joanna
GATHER_TIMEOUT_SECONDS=5
GATHER_SPEECH_TIMEOUT=auto

# --- Owner notifications ---
NOTIFY_SMS_FROM=+1-555-0100
NOTIFY_EMAIL_FROM=notifications@example.com
# SMTP for email notifications (leave blank to skip email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=fake-smtp-password

# --- Spend caps (safety limits so a bug can't run up a huge bill) ---
# The app should stop making paid calls once any cap is reached.
SPEND_CAP_MONTHLY_USD=25
SPEND_CAP_DAILY_USD=5
MAX_CALL_MINUTES=10
MAX_LLM_TURNS_PER_CALL=30
# TODO(me): Also set a monthly spend limit in each vendor's own console.
# That limit works even if our code has a bug.
